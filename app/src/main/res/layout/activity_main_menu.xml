<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_main_menu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:background="@color/background_gray"
    tools:context=".ui.activities.MainMenuActivity">

    <!-- Games menu navigation button -->
    <Button
        android:id="@+id/bttn_activity_main_menu_games_menu"
        android:textColor="@color/white"
        android:background="@color/button_green"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="20dp"
        android:text="@string/games"
        android:onClick="onClickGamesMenu"/>

    <!-- Manage Groups navigation button -->
    <Button
        android:id="@+id/bttn_activity_main_menu_manage_groups"
        android:textColor="@color/white"
        android:background="@color/button_green"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/bttn_activity_main_menu_games_menu"
        android:text="@string/groups"
        android:layout_marginBottom="20dp"
        android:onClick="onClickManageFrolfGroups"/>

    <!-- Manage Invites navigation button -->
    <Button
        android:id="@+id/bttn_activity_main_menu_manage_invites"
        android:textColor="@color/white"
        android:background="@color/button_green"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/bttn_activity_main_menu_manage_groups"
        android:text="@string/invites"
        android:layout_marginBottom="20dp"
        android:onClick="onClickManageInvites"/>

    <!-- Account navigation button -->
    <Button
        android:id="@+id/bttn_activity_main_menu_account"
        android:textColor="@color/white"
        android:background="@color/button_green"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/bttn_activity_main_menu_manage_invites"
        android:text="@string/account"
        android:layout_marginBottom="20dp"
        android:onClick="onClickAccount"/>

    <!-- Help button -->
    <Button
        android:id="@+id/help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:background="@color/button_green"
        android:layout_below="@+id/bttn_activity_main_menu_account"
        android:text="@string/help_app"
        android:layout_marginBottom="20dp"
        android:onClick="onClickHelp"/>

</RelativeLayout>
