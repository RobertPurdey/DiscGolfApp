<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="accountViewModel"
            type="robert.purdey.caddytracker.ui.viewmodels.AccountViewModel" />
    </data>

    <RelativeLayout
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/activity_account"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:background="@color/background_gray"
        tools:context="robert.purdey.caddytracker.ui.activities.AccountActivity">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:gravity="top"
            android:orientation="vertical">

            <!-- Login name label -->
            <TextView
                android:id="@+id/txtv_activity_account_loginname_label"
                android:layout_width="fill_parent"
                android:layout_height="20dp"
                android:textSize="16dp"
                android:text="@string/login_name"
                android:layout_marginLeft="5dp"
                android:textColor="@color/white"/>

            <!-- Username text input -->
            <EditText
                android:id="@+id/etxt_activity_account_loginname"
                android:inputType="text|textNoSuggestions"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_margin="5dp"
                android:background="@android:color/white"
                android:paddingLeft="10dp"
                android:maxLines="1"
                android:text="@={accountViewModel.loginName}"/>

            <!-- Handle name label -->
            <TextView
                android:id="@+id/txtv_activity_account_handle_label"
                android:layout_width="fill_parent"
                android:layout_height="20dp"
                android:textSize="16dp"
                android:text="@string/handle"
                android:layout_marginTop="5dp"
                android:layout_marginLeft="5dp"
                android:textColor="@color/white"/>

            <!-- Handle text input -->
            <EditText
                android:id="@+id/etxt_activity_account_handle"
                android:inputType="text|textNoSuggestions"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_margin="5dp"
                android:background="@android:color/white"
                android:paddingLeft="10dp"
                android:maxLines="1"
                android:text="@={accountViewModel.handle}"/>

            <!-- friend code label -->
            <TextView
                android:id="@+id/txtv_activity_account_friend_code_label"
                android:layout_width="fill_parent"
                android:layout_height="20dp"
                android:textSize="16dp"
                android:text="@string/friend_code"
                android:layout_marginTop="5dp"
                android:layout_marginLeft="5dp"
                android:textColor="@color/white"/>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:gravity="top"
            android:orientation="horizontal">

                <!-- friend code text input -->
                <EditText
                    android:id="@+id/etxt_activity_account_friend_code"
                    android:layout_width="180dp"
                    android:layout_height="40dp"
                    android:layout_margin="5dp"
                    android:background="@android:color/white"
                    android:paddingLeft="10dp"
                    android:maxLines="1"
                    android:clickable="false"
                    android:inputType="textNoSuggestions"
                    android:text="@={accountViewModel.friendCode}" />

                <!-- share friend code bttn -->
                <Button
                    android:id="@+id/bttn_activity_account_share_friend_code"
                    android:onClick="onShareFriendCode"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:layout_margin="5dp"
                    android:textColor="@color/white"
                    android:background="@color/button_green"
                    android:paddingLeft="10dp"
                    android:text="@string/share" />

            </LinearLayout>

            <!-- Save account button -->
            <Button
                android:id="@+id/bttn_activity_account_save"
                android:textColor="@color/white"
                android:background="@color/button_green"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_margin="5dp"
                android:text="@string/save"
                android:onClick="onSave"/>

        </LinearLayout>

    </RelativeLayout>

</layout>