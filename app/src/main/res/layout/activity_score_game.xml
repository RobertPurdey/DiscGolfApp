<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="scoreGameActivViewModel"
            type="robert.purdey.caddytracker.ui.viewmodels.ScoreGameActivityViewModel" />
    </data>

    <RelativeLayout
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/activity_score_game"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:background="@color/background_gray"
        tools:context="robert.purdey.caddytracker.ui.activities.ScoreGameActivity">

        <!-- Course name -->
        <TextView
            android:id="@+id/txtv_activity_score_course_name"
            android:text=""
            android:layout_width="250dp"
            android:layout_height="20dp"
            android:textSize="14dp"
            android:textColor="@color/white"/>

        <!-- Hole label -->
        <TextView
            android:id="@+id/txtv_activity_score_game_hole_lbl"
            android:text="@string/hole"
            android:layout_width="35dp"
            android:layout_height="20dp"
            android:layout_below="@+id/txtv_activity_score_course_name"
            android:textSize="13dp"
            android:textColor="@color/white"/>

        <!-- Current hole -->
        <TextView
            android:id="@+id/txtv_activity_score_game_current_hole"
            android:text="@={scoreGameActivViewModel.CurrentHoleLbl}"
            android:layout_width="25dp"
            android:layout_height="20dp"
            android:layout_below="@+id/txtv_activity_score_course_name"
            android:textColor="@color/white"
            android:textSize="13dp"
            android:layout_toRightOf="@id/txtv_activity_score_game_hole_lbl"/>


        <!-- Par label -->
        <TextView
            android:id="@+id/txtv_activity_score_game_par_lbl"
            android:text="@string/par"
            android:layout_width="30dp"
            android:layout_height="20dp"
            android:layout_below="@+id/txtv_activity_score_course_name"
            android:textSize="13dp"
            android:layout_toRightOf="@id/txtv_activity_score_game_current_hole"
            android:textColor="@color/white"/>

        <!-- Current hole -->
        <TextView
            android:id="@+id/txtv_activity_score_game_par"
            android:text="@={scoreGameActivViewModel.ParLbl}"
            android:layout_width="30dp"
            android:layout_height="20dp"
            android:layout_below="@+id/txtv_activity_score_course_name"
            android:textColor="@color/white"
            android:textSize="13dp"
            android:layout_toRightOf="@id/txtv_activity_score_game_par_lbl"/>

        <!-- Prev button -->
        <Button
            android:id="@+id/bttn_score_game_activity_prev_hole"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:layout_below="@+id/txtv_activity_score_course_name"
            android:textColor="@color/white"
            android:background="@color/button_green2"
            android:text="&lt;"
            android:textSize="20dp"
            android:textAlignment="center"
            android:layout_marginRight="10dp"
            android:layout_marginLeft="35dp"
            android:layout_toLeftOf="@id/bttn_score_game_activity_next_hole"
            android:onClick="onPrevHoleClick"/>

        <!-- Next button -->
        <Button
            android:id="@+id/bttn_score_game_activity_next_hole"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:layout_below="@+id/txtv_activity_score_course_name"
            android:textColor="@color/white"
            android:background="@color/button_green2"
            android:text="&gt;"
            android:textSize="20dp"
            android:textAlignment="center"
            android:layout_alignParentRight="true"
            android:onClick="onNextHoleClick"/>

        <!-- Player column label -->
        <TextView
            android:id="@+id/txtv_activity_score_game_player_lbl"
            android:text="@string/player"
            android:layout_width="90dp"
            android:layout_height="20dp"
            android:layout_below="@+id/bttn_score_game_activity_prev_hole"
            android:textSize="12dp"
            android:paddingLeft="10dp"
            android:textColor="@color/white"/>

        <!-- Strokes column label -->
        <TextView
            android:id="@+id/txtv_activity_score_game_strokes_lbl"
            android:text="@string/strokes"
            android:layout_width="45dp"
            android:layout_marginLeft="28dp"
            android:layout_height="20dp"
            android:layout_below="@+id/bttn_score_game_activity_prev_hole"
            android:layout_toRightOf="@+id/txtv_activity_score_game_player_lbl"
            android:textSize="12dp"
            android:textColor="@color/white"/>

        <!-- Score column label -->
        <TextView
            android:id="@+id/txtv_activity_score_game_score_lbl"
            android:text="@string/score"
            android:layout_width="40dp"
            android:layout_height="20dp"
            android:layout_marginLeft="12dp"
            android:layout_below="@+id/bttn_score_game_activity_prev_hole"
            android:layout_toRightOf="@+id/txtv_activity_score_game_strokes_lbl"
            android:textSize="12dp"
            android:textColor="@color/white"/>


        <!-- Score game hole scores fragment -->
        <fragment
            android:name="robert.purdey.caddytracker.ui.fragments.GameHoleScoresFragment"
            android:id="@+id/frag_mng_game_hole_scores_fragment"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_below="@id/txtv_activity_score_game_player_lbl"
            />

    </RelativeLayout>
</layout>