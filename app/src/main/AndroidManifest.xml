<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="robert.purdey.caddytracker">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ui.FrolfApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <!-- Login -->
        <activity
            android:name=".ui.activities.LoginActivity"
            android:label="@string/app_name"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Menu -->
        <activity android:name=".ui.activities.MainMenuActivity" />

        <!-- Create New Game -->
        <activity
            android:name=".ui.activities.NewGameActivity"
            android:parentActivityName=".ui.activities.MainMenuActivity" />

        <!-- Resume Game -->
        <activity
            android:name=".ui.activities.ResumeGameActivity"
            android:parentActivityName=".ui.activities.MainMenuActivity" />

        <!-- Game Results -->
        <activity
            android:name=".ui.activities.GameResultsActivity"
            android:parentActivityName=".ui.activities.MainMenuActivity" />

        <!-- Manage Groups -->
        <activity
            android:name=".ui.activities.ManageFrolfGroupsActivity"
            android:parentActivityName=".ui.activities.MainMenuActivity" />

        <!-- Create/Edit Group -->
        <activity
            android:name=".ui.activities.FrolfGroupRecordActivity"
            android:parentActivityName=".ui.activities.ManageFrolfGroupsActivity" />

        <!-- Manage Invites -->
        <activity
            android:name=".ui.activities.ManageInvitesActivity"
            android:parentActivityName=".ui.activities.MainMenuActivity" />

        <!-- Score Game -->
        <activity android:name=".ui.activities.ScoreGameActivity" />

        <!-- View Game Score and other results -->
        <activity
            android:name=".ui.activities.ScoreCardActivity"
            android:parentActivityName=".ui.activities.GameResultsActivity"/>
    </application>

</manifest>